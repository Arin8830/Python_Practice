def is_even(num):
    """
    this is even number checking code.
    """
    if num %2==0:
        return "even"
    else:
        return "odd"

for i in range(1,11):
    x=is_even(i)
    print(x)


#types of arguements
# 1)default arguements
# 2)positional arguements
# 3)keyword arguements

def power(a=1,b=2): #by default value is set in our side so no error came.
    return a**b

power()

power(2,3)  #these values goes from a and b by default that is called as positional arguements.

#keyword arguements
power(b=3,a=2)



#args
# suppose you make a function of multiply but user to give the,
# input more than 2 numbers or more in this case ags will be use.

def mul(a,b):
    return a*b

mul(3,2)  #by normal 

def multiply(*args):  #by using args
    product=1
    for i in args:
        product=product * i
    return product 

multiply(3,2,4,5,6,7,9,5,8,3,4,8,6,4,1)

#kwargs
#if you pass dictionary or key-value pairs then use kwargs:

def display(**kwargs):

    for (key,value) in kwargs.items():
        print(key,'->',value)

display(india='delhi')


