# OOP means organizing code using objects and classes instead of just functions.

# Real-life example:

# Class = Blueprint (Car design)
# Object = Actual car (BMW, Audi)


class Student:
    def __init__(self, name, age):
        self.name = name
        self.age = age

    def show(self):
        print("Name:", self.name)
        print("Age:", self.age)


# Creating object
s1 = Student("MAX", 21)

s1.show()
