#Set Syntax

city1={"Nagpur","Mumbai","Pune"}
print(city1)
#Set items are unordered, unchangeable, and do not allow duplicate values

#empty set

s= set()
print(s)

thisset = {"apple", "banana", "cherry", "apple"} #Duplocates value not allowed
print(thisset)
print("")

#Accesing items in sets 

# You cannot access items in a set by referring to an index or a key.
# But you can loop through the set items using a for loop, or ask if a specified value is present in a set,
#by using the in keyword.

for x in city1:
    print(x)
print("")

#Change item
#Once a set is created, you cannot change its items, but you can add new items.

#Add or Remove item in sets

city1.add("kolhapur")
print(city1)

city1.remove("Nagpur")
print(city1)

#discard.pop,clear,del method is similar to remove method.
print("")

#frozenset

# frozenset is an immutable version of a set.

# Like sets, it contains unique, unordered, unchangeable elements.

# Unlike sets, elements cannot be added or removed from a frozenset.

x = frozenset({"apple", "banana", "cherry"})
print(x)
print(type(x))
print("")

