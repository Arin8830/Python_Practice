#Accessing String By Indexing

a="python"
print(a[0])
print(a[1])
print(a[4])
print(a[-1])

#String Slicing
#Syntax: (start:end)

a= "Python"
print(a[0:3])

print(a[2:5])

#slicing from start
print(a[:5])

#Slicing From end
print(a[5:])


#String Concatination
a = "Hello"
b = "World"
print(a + " " + b)


